# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
HEALER_TIMEOUT_MS=300
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=25
TARGET_BASE_URL=http://localhost:5000
SAMPLE_APP_PORT=5000
DASHBOARD_PORT=8501
SQLITE_PATH=storage/test_runs.db
LOG_WATCH_PATH=storage/app.log
LOG_LEVEL=INFO
OWASP_PAYLOAD_SET=standard
