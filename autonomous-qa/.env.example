# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production

# --- Database ---
DATABASE_URL=postgresql+psycopg2://qa_user:qa_password@localhost:5432/autonomous_qa
ASYNC_DATABASE_URL=postgresql+asyncpg://qa_user:qa_password@localhost:5432/autonomous_qa

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI (Groq) ---
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Browser automation ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_ENGINE_DEFAULT=playwright
MAX_CONCURRENT_BROWSER_CONTEXTS=3

# --- Test generation / execution ---
MAX_TESTS_PER_RUN=25
RUN_TIMEOUT_SECONDS=900

# --- Self-healing ---
HEALING_ENABLED=true
HEALING_CONFIDENCE_THRESHOLD=0.85
HEALING_LLM_FALLBACK_ENABLED=true

# --- Security ---
# Comma-separated allowlist of domains the platform is allowed to crawl.
# Leave empty to allow any public domain (private/internal IPs are still
# blocked unless ALLOW_PRIVATE_NETWORK_TARGETS=true).
ALLOWED_DOMAINS=
# Only enable this for local development against the bundled demo-app.
ALLOW_PRIVATE_NETWORK_TARGETS=true
MAX_REQUEST_BODY_BYTES=2000000
RATE_LIMIT_PER_MINUTE=60

# --- Data retention (days); 0 = keep forever ---
RETENTION_SCREENSHOTS_DAYS=30
RETENTION_TRACES_DAYS=14
RETENTION_AI_REQUESTS_DAYS=90
RETENTION_SNAPSHOTS_DAYS=180

# --- Demo app ---
LOGIN_LABEL=Login
DEMO_APP_SECRET=demo-secret-key-not-for-production

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
